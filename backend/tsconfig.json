{
  // Visit https://aka.ms/tsconfig to read more about this file
  
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "types": ["node"],
    "lib": ["ES2020"],

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true
  }

}
